flowchart TD
    subgraph MainComponent["main component"]
        MainC["main/main.c"]
        AppStateH["main/app_state.h"]
        AppStateC["main/app_state.c"]
        CommandTaskC["main/command_task.c"]
        MotorTaskC["main/motor_task.c"]
        SensorTaskC["main/sensor_task.c"]
        MainCMake["main/CMakeLists.txt"]
    end

    MainCMake --> MainC
    MainCMake --> AppStateC
    MainCMake --> CommandTaskC
    MainCMake --> MotorTaskC
    MainCMake --> SensorTaskC

    MainC --> AppStateH
    AppStateC --> AppStateH
    CommandTaskC --> AppStateH
    MotorTaskC --> AppStateH
    SensorTaskC --> AppStateH

    MainC --> AppMain["app_main()"]
    AppMain --> MutexCreate["create motor_mutex and console_mutex"]
    AppMain --> ConfigureConsole["configure_console()"]
    AppMain --> ConfigurePWM["configure_pwm()"]
    AppMain --> ConfigureSensors["configure_sensors()"]
    AppMain --> CreateMicrorlTask["xTaskCreate(microrl_task)"]
    AppMain --> CreateMotorTask["xTaskCreate(motor_controller_task, &motors[0])"]
    AppMain --> CreateSensorTask["xTaskCreate(sensor_reader_task)"]
    AppMain --> ReadyLine["console_print(READY conveyor)"]

    AppStateH --> MotorStruct["motor_t struct"]
    AppStateH --> SensorStruct["sensor_t struct"]
    AppStateH --> SharedDecls["extern shared state and task prototypes"]

    AppStateC --> MotorsArray["motors[MOTOR_COUNT]"]
    AppStateC --> SensorsArray["sensors[SENSOR_COUNT]"]
    AppStateC --> MotorMutex["motor_mutex"]
    AppStateC --> ConsoleMutex["console_mutex"]
    AppStateC --> SensorWatchFlag["sensor_watch_enabled"]
    AppStateC --> ConsolePrint["console_print()"]
    AppStateC --> ConsolePrintf["console_printf()"]
    AppStateC --> FindMotor["find_motor()"]

    CommandTaskC --> ExecuteCommand["execute_command()"]
    CommandTaskC --> MicrorlTask["microrl_task()"]
    MicrorlTask --> MicrorlInit["microrl_init()"]
    MicrorlTask --> MicrorlSetCallback["microrl_set_execute_callback()"]
    MicrorlTask --> ConsoleRead["getchar() from stdin"]
    MicrorlTask --> MicrorlInsert["microrl_insert_char()"]
    MicrorlSetCallback --> ExecuteCommand
    ExecuteCommand --> FindMotor
    ExecuteCommand --> ConsolePrint
    ExecuteCommand --> ConsolePrintf
    ExecuteCommand --> MotorMutex
    ExecuteCommand --> MotorsArray
    ExecuteCommand --> SensorWatchFlag

    MotorTaskC --> ConfigurePWM
    MotorTaskC --> MotorControllerTask["motor_controller_task()"]
    ConfigurePWM --> LedcTimer["ledc_timer_config()"]
    ConfigurePWM --> DirGPIOSetup["gpio_set_direction() and gpio_set_level()"]
    ConfigurePWM --> LedcChannel["ledc_channel_config()"]
    MotorControllerTask --> MotorMutex
    MotorControllerTask --> MotorsArray
    MotorControllerTask --> GpioOutput["gpio_set_level()"]
    MotorControllerTask --> LedcDuty["ledc_set_duty()"]
    MotorControllerTask --> LedcUpdate["ledc_update_duty()"]

    SensorTaskC --> ConfigureSensors
    SensorTaskC --> SensorReaderTask["sensor_reader_task()"]
    ConfigureSensors --> SensorGPIOConfig["gpio_config(input, no pulls)"]
    ConfigureSensors --> SensorInitialRead["gpio_get_level()"]
    SensorReaderTask --> SensorsArray
    SensorReaderTask --> SensorRead["gpio_get_level()"]
    SensorReaderTask --> SensorWatchFlag
    SensorReaderTask --> ConsolePrintf

    subgraph MicrorlComponent["components/microrl"]
        MicrorlHeader["microrl.h"]
        MicrorlStruct["microrl_t struct"]
        MicrorlInit
        MicrorlSetCallback
        MicrorlInsert
        MicrorlRunLine["microrl_run_line()"]
        MicrorlClear["microrl_clear()"]
    end

    MicrorlHeader --> MicrorlStruct
    MicrorlInit --> MicrorlClear
    MicrorlInsert --> MicrorlRunLine
    MicrorlRunLine --> ExecuteCommand
