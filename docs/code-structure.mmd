stateDiagram-v2
    direction TB

    state "main/" as Main {
        direction LR
        MainC: main.c
        AppMain: app_main
    }

    state "main/config/" as Config {
        direction LR
        ConfigH: config.h defaults
        RuntimeH: runtime_config.h API
        RuntimeC: runtime_config.c NVS-backed values
    }

    state "main/shared/" as Shared {
        direction LR
        AppStateH: app_state.h shared types/API
        AppStateC: app_state.c shared tables/helpers
        Motors: motors[] M0
        Sensors: sensors[] S0/S1
    }

    state "main/tasks/" as Tasks {
        direction LR
        CommandTask: command_task.c microrl_task
        SensorTask: sensor_task.c sensor_reader_task
        MotorTask: motor_task.c PWM setup
        EncoderTask: encoder_task.c PCNT setup
        MotorPidTask: motor_pid_task.c motor_pid_task
        MqttTask: mqtt_task.c mqtt_status_task
    }

    state "main/conveyor/" as Conveyor {
        direction LR
        ConveyorH: conveyor_job.h commands/states/status
        ConveyorC: conveyor_job.c conveyor_job_task
        ConveyorQueue: conveyor_cmd_queue
        ConveyorStates: IDLE/TX/RX/DONE/ERROR/ESTOP
    }

    state "components/microrl/" as Components {
        direction LR
        MicrorlComponent: microrl command parser
    }

    state "Hardware and network APIs" as Platform {
        direction LR
        GpioLedc: ESP-IDF GPIO/LEDC
        Pcnt: ESP-IDF PCNT
        WifiMqtt: ESP-IDF WiFi/MQTT
        Nvs: ESP-IDF NVS
    }

    [*] --> Main

    MainC --> AppMain
    AppMain --> Config: load runtime config
    AppMain --> Shared: create mutexes/use tables
    AppMain --> Tasks: configure hardware and start tasks
    AppMain --> Conveyor: create job queue/start job task

    ConfigH --> RuntimeC
    RuntimeH --> RuntimeC
    RuntimeC --> Nvs

    AppStateH --> AppStateC
    AppStateC --> Motors
    AppStateC --> Sensors

    CommandTask --> MicrorlComponent
    CommandTask --> Shared
    CommandTask --> Conveyor
    CommandTask --> Config

    SensorTask --> Shared
    SensorTask --> GpioLedc
    MotorTask --> Shared
    MotorTask --> GpioLedc
    EncoderTask --> Shared
    EncoderTask --> Pcnt
    MotorPidTask --> Shared
    MotorPidTask --> Config
    MotorPidTask --> GpioLedc
    MotorPidTask --> Pcnt
    MqttTask --> Conveyor
    MqttTask --> Config
    MqttTask --> WifiMqtt

    ConveyorH --> ConveyorC
    ConveyorC --> ConveyorQueue
    ConveyorC --> ConveyorStates
    ConveyorC --> Shared
    ConveyorC --> Config
    ConveyorC --> MqttTask
