stateDiagram-v2
    direction TB

    state "Inputs\nThings outside the firmware" as Inputs {
        SerialIn: USB serial\nDebug commands from monitor/wrapper
        MqttIn: MQTT topics\nRemote TX/RX/emergency commands
        SensorIn: S0/S1 sensors\nActive-low tray detection
        EncoderIn: M0 encoder\nQuadrature motor feedback
    }

    state "Command and status layer\nTurns outside messages into internal requests" as Commands {
        SerialParser: microrl_task\nParses strict serial commands
        MqttClient: mqtt_task\nParses compact MQTT payloads
        Feedback: status publishers\nSerial lines and MQTT JSON
    }

    state "Conveyor control\nOwns high-level tray movement" as Conveyor {
        JobQueue: conveyor_cmd_queue\nBuffers TX/RX/stop/clear requests
        JobState: conveyor_job_task\nRuns IDLE/TX/RX/DONE/ERROR/ESTOP logic
        TrayState: tray status\nReads S0/S1 and derives has_tray
    }

    state "Shared settings and state\nData used by multiple tasks" as Shared {
        RuntimeConfig: runtime config\nNVS-backed speed, gains, timeouts
        MotorState: motors[]\nM0 target speed, PWM, direction, encoder data
        SensorState: sensors[]\nLatest S0/S1 GPIO values
    }

    state "Motor control\nTurns movement requests into hardware output" as MotorControl {
        MotorPid: motor_pid_task\nReads encoder speed and controls PWM
        SpeedControl: speed control\nFeed-forward plus P/D trim and slew
    }

    state "Outputs\nWhat the firmware drives or reports" as Outputs {
        MotorHw: MD30C and motor\nPWM plus direction GPIO
        SerialOut: serial output\nREADY, OK, ERR, EVENT, CONFIG lines
        MqttOut: MQTT output\nFeedback and tray status topics
    }

    [*] --> Inputs
    Inputs --> Commands
    Inputs --> Shared
    Commands --> Conveyor
    Shared --> Conveyor
    Conveyor --> MotorControl
    Shared --> MotorControl
    MotorControl --> Outputs
    Conveyor --> Outputs
    Commands --> Outputs
