        MotorState["M0 shared motor state"]
        MotorPid["motor_pid_task"]
        EncoderSetup["PCNT encoder setup"]
    end

    subgraph Sensors["Tray Sensors"]
        SensorTask["sensor_reader_task"]
        SensorState["S0/S1 shared sensor state"]
    end

    subgraph Hardware["Hardware"]
        Encoder["M0 encoder GPIO15/GPIO16"]
        Driver["MD30C driver"]
        MotorHw["DC motor"]
        SensorHw["S0/S1 GPIO4/GPIO5"]
    end

    Serial --> Commands
    Mqtt --> MqttTask

    Commands --> Job
    MqttTask --> Job
